TYPESAFE_API_KEY=
# Optional: an absolute or relative path to a yt-dlp binary, when the one on
# your PATH is too old for YouTube's current signatures. Leave blank to use
# whatever `yt-dlp` resolves to.
YT_DLP=
# Optional: the interface `npm start` binds to. The default is 127.0.0.1 —
# loopback only — because this server downloads whatever video id it is handed
# and serves it back off your disk. Set it to 0.0.0.0 only if you mean to put
# that on your network.
HOST=
# Optional: the port. Defaults to 5173, the same one `npm run dev` uses.
PORT=
